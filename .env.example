PORT=3000
# gere um segredo forte, ex.: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-forte
JWT_EXPIRES_IN=1h

# Banco (docker compose) - sem DATABASE_URL a API usa memória
POSTGRES_PASSWORD=troque-esta-senha
# DATABASE_URL=postgres://vendas:senha@localhost:5432/vendas

# OAuth 2.0 client credentials (em produção é obrigatório definir para habilitar)
OAUTH_CLIENT_ID=meu-cliente
OAUTH_CLIENT_SECRET=troque-este-segredo
