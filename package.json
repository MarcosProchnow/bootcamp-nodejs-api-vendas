{
  "name": "bootcamp-nodejs-api-vendas",
  "version": "1.1.0",
  "description": "API REST de vendas (Express, JWT, OAuth 2.0, GraphQL, Sequelize, Jest) - Bootcamp Desenvolvedor(a) Node.js | Pós-Graduação Full Stack e Full Cycle",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["nodejs", "express", "jwt", "oauth2", "graphql", "sequelize", "jest", "bootcamp"],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "graphql": "^16.8.1",
    "graphql-http": "^1.22.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "sqlite3": "^5.1.7",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["src/**/*.js", "!src/server.js"]
  }
}
